<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".LuminaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Lumina"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lumina">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Lumina">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Music Player Widget -->
        <receiver
            android:name=".widgets.MusicPlayerWidgetReceiver"
            android:exported="true"
            android:label="Music Player">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/music_player_widget_info" />
        </receiver>

        <!-- Liquid Clock Widget -->
        <receiver
            android:name=".widgets.LiquidClockWidgetReceiver"
            android:exported="true"
            android:label="Liquid Clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/liquid_clock_widget_info" />
        </receiver>

        <!-- Battery Widget -->
        <receiver
            android:name=".widgets.BatteryWidgetReceiver"
            android:exported="true"
            android:label="Custom Battery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/battery_widget_info" />
        </receiver>

        <!-- Focus Timer Widget -->
        <receiver
            android:name=".widgets.FocusTimerWidgetReceiver"
            android:exported="true"
            android:label="Focus Timer">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/focus_timer_widget_info" />
        </receiver>

        <!-- Quote Widget -->
        <receiver
            android:name=".widgets.QuoteWidgetReceiver"
            android:exported="true"
            android:label="Quote">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quote_widget_info" />
        </receiver>

        <!-- Ambient / Mood Widget -->
        <receiver
            android:name=".widgets.AmbientWidgetReceiver"
            android:exported="true"
            android:label="Ambient Mood">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ambient_widget_info" />
        </receiver>

    </application>

</manifest>
